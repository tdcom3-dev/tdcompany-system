# Optional: local execution works without credentials; generation requires this key.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TEXT_MODEL=gpt-4.1-mini
AI_IMAGE_MODEL=gpt-image-1
AI_VIDEO_MODEL=sora-2
PORT=3001
# Honor the managed environment proxy, with certificate verification enabled.
NODE_USE_ENV_PROXY=1
